<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <location path="." inheritInChildApplications="false">
        <system.webServer>
            <handlers>
                <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
            </handlers>
            <aspNetCore processPath="dotnet" arguments=".\MtgToolsApi.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
            <security>
                <requestFiltering>
                    <requestLimits maxAllowedContentLength="504857600" /> <!-- 500 MB -->
                </requestFiltering>
            </security>
        </system.webServer>
        <system.web>
            <httpRuntime maxRequestLength="502400" /> <!-- 500 MB -->
        </system.web>
    </location>
</configuration>